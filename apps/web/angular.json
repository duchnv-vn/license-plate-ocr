{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "platevision-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/platevision-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets/" }]
          },
          "configurations": {
            "production": {"optimization": true, "outputHashing": "all", "budgets": [{"type":"initial","maximumWarning":"900kb","maximumError":"2mb"}]},
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {"development":{"buildTarget":"platevision-web:build:development"}},
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
